      "2025-01",
      "2025-07",
      "2025-11",
      "2025-12"
    ],
    "rematch": {
      "inputs": "departures with FLIGHT_ID_mvt missing at EDDF / EHAM: 2025-01 + 2025-12 (arcw5), 2025-07 + 2025-11 (arcw2), ranking (arcw1); adsb.lol surface files (ODbL) on those workers",
      "outputs": {
        "runs/adsb_rematch/out_arcw1.parquet": "64b5c29e944a16c00a9f61b0603dfb133d8c9262568e66b8495b16442ed620d4",
